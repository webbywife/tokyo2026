# Copy this file to credentials.yml and fill in real values.
# credentials.yml is gitignored — it never gets committed.

cloudflare:
  account_id: e1fbec5d4923357bd48428409f0145b7   # Jose Angelo Abarentos (personal)

  # Create at https://dash.cloudflare.com/profile/api-tokens
  #   Create Token -> Custom token, scoped to the personal account ONLY:
  #     Account · Cloudflare Pages       · Edit
  #     Account · Workers Scripts        · Edit
  #     Account · Workers KV Storage     · Edit
  # This cannot be minted from the CLI: a wrangler OAuth session is not
  # permitted to create API tokens (403, code 9109). Dashboard only.
  api_token: PASTE_TOKEN_HERE

trip:
  # The shared write key for the sync worker. Already generated and already set
  # as the Worker secret — this is just a readable copy so you can type it into
  # each phone. Canonical copy lives in .trip-key (also gitignored).
  write_key: SEE_DOT_TRIP_KEY
